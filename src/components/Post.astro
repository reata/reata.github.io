---
import type { PostItem } from "../types";

interface Props {
  posts: PostItem[];
}

const { posts } = Astro.props;
---

<div>
  <h2 style="font-size: 1.25rem; font-weight: 500; margin: 0 0 16px 0;">
    From the firehose
  </h2>
  <hr
    style="border: none; border-top: 1px solid var(--border-color); margin: 0 0 24px 0;"
  />
  {
    posts.map((post) => (
      <div
        class="post-card"
        style="display: flex; border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden; margin-bottom: 32px;"
      >
        <div style="flex: 1; padding: 16px;">
          <h3 style="font-size: 1.5rem; font-weight: 700; margin: 16px 0 0 0;">
            <a href={post.slug} style="color: inherit; text-decoration: none;">
              {post.title}
            </a>
          </h3>
          <p style="color: var(--text-secondary); margin: 8px 0 0 0;">
            {post.excerpt}
          </p>
          <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 16px 0 0 0;">
            {post.date} · {post.readMinutes} min read
          </p>
        </div>
        <div
          class="post-image"
          style="display: none; width: 200px; height: 150px; flex-shrink: 0;"
        >
          <img
            src={post.image}
            alt={post.title}
            style="width: 100%; height: 100%; object-fit: cover;"
          />
        </div>
      </div>
    ))
  }
</div>

<style>
  @media (min-width: 600px) {
    .post-image {
      display: block !important;
    }
  }
</style>
