---
import type { PostItem } from "../types";

interface Props {
  posts: PostItem[];
}

const { posts } = Astro.props;
---

<div class="featured-posts">
  {
    posts.map((post) => (
      <a
        href={post.slug}
        class="featured-card"
        style="text-decoration: none; color: inherit;"
      >
        <div
          class="featured-card-inner"
          style="display: flex; border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden;"
        >
          <div style="flex: 1; padding: 16px;">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin: 0 0 8px 0; min-height: 90px;">
              {post.title}
            </h2>
            <p style="color: var(--text-secondary); margin: 0 0 16px 0;">
              {post.excerpt}
            </p>
            <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
              {post.date} · {post.readMinutes} min read
            </p>
          </div>
          <div
            class="featured-image"
            style="display: none; width: 160px; flex-shrink: 0;"
          >
            <img
              src={post.image}
              alt={post.title}
              style="width: 100%; height: 100%; object-fit: cover;"
            />
          </div>
        </div>
      </a>
    ))
  }
</div>

<style>
  .featured-posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  @media (min-width: 600px) {
    .featured-posts {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .featured-image {
      display: block !important;
    }
  }
</style>
