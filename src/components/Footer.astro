---
import { SITE } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();

const socials = [
  {
    name: "github" as const,
    href: SITE.authorGitHub,
    label: "GitHub",
    external: true,
  },
  { name: "email" as const, href: SITE.authorEmail, label: "Email" },
  {
    name: "location" as const,
    href: SITE.authorLocation,
    label: "Location",
    external: true,
  },
];
---

<footer class="site-footer">
  <div class="footer-inner" style={`max-width: ${SITE.maxWidth};`}>
    <div class="footer-brand">
      <a class="footer-name" href="/">{SITE.author}</a>
      <span class="footer-dot" aria-hidden="true"></span>
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>

    <div class="footer-meta">
      <p class="footer-copy">
        <span>&copy; {year}</span>
        <a href={SITE.url}>reata.github.io</a>
        <span class="footer-sep" aria-hidden="true">&middot;</span>
        <span class="footer-powered">
          Built with <a href="https://astro.build" rel="noopener noreferrer"
            >Astro</a
          >
        </span>
      </p>

      <ul class="footer-social">
        {
          socials.map((social) => (
            <li>
              <a
                class="social-link"
                href={social.href}
                aria-label={social.label}
                title={social.label}
                target={social.external ? "_blank" : undefined}
                rel={social.external ? "noopener noreferrer" : undefined}
              >
                <Icon name={social.name} size={18} color="currentColor" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    flex-shrink: 0;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.025);
    border-top: 1px solid var(--border-color);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin: 0 auto;
    padding: 16px 24px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .footer-name {
    font-family: Georgia, "Times New Roman", "Songti SC", serif;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-name:hover,
  .footer-name:focus-visible {
    color: #000;
  }

  .footer-dot {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--text-secondary);
    opacity: 0.5;
  }

  .footer-tagline {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-copy {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .footer-sep {
    padding: 0 2px;
    opacity: 0.7;
  }

  .footer-copy a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .footer-copy a:hover,
  .footer-copy a:focus-visible {
    color: var(--text-primary);
    border-bottom-color: currentColor;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color 0.22s ease,
      background-color 0.22s ease,
      transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: #140d0f;
    background-color: rgba(20, 13, 15, 0.08);
    transform: translateY(-2px);
  }

  .social-link:focus-visible,
  .footer-name:focus-visible,
  .footer-copy a:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  @media (max-width: 860px) {
    .footer-tagline,
    .footer-dot {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    .footer-meta {
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px 12px;
    }

    .footer-copy {
      white-space: normal;
    }

    .footer-powered {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-name,
    .footer-copy a,
    .social-link {
      transition: none;
    }

    .social-link:hover,
    .social-link:focus-visible {
      transform: none;
    }
  }
</style>
