---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import gists from "../data/gists";
---

<BaseLayout>
  <div style="margin-top: 24px;">
    <h1
      style="font-size: 2.125rem; font-weight: 400; line-height: 1.235; letter-spacing: 0.00735em; text-align: center; margin-bottom: 24px;"
    >
      代码拾遗 via Github Gist
    </h1>
    <div style="display: flex; flex-direction: column;">
      {
        gists.map((gist) => (
          <a
            href={gist.link}
            target="_blank"
            style="display: flex; align-items: center; gap: 16px; padding: 12px 16px; color: inherit; text-decoration: none; border-radius: var(--border-radius); font-size: 1rem; line-height: 1.5; letter-spacing: 0.00938em;"
          >
            <Icon name="link" size={24} />
            <span>{gist.title}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
