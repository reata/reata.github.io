---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main
    style="color: var(--text-secondary); padding: 96px; font-family: Roboto, Helvetica, Arial, sans-serif;"
  >
    <h1 style="margin-top: 0; margin-bottom: 64px; max-width: 320px;">
      Page not found
    </h1>
    <p style="margin-bottom: 48px;">
      Sorry <span role="img" aria-label="Pensive emoji">😔</span> we couldn&rsquo;t
      find what you were looking for.
      <br /><br />
      <a href="/">Go home</a>.
    </p>
  </main>
</BaseLayout>
